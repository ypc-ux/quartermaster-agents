# DISPATCH — server-side env template (values live in .env.local / Vercel, never committed)
# Copy to .env.local for local runs.

# Supabase (system of record)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE=service_role_key_here

# LLM routing
OPENROUTER_API_KEY=sk-or-...
# Optional: classify via Groq instead of OpenRouter :free
# GROQ_API_KEY=gsk_...

# Drafts (any OpenRouter model id)
# DRAFT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Engine
ENGINE_MODE=draft            # active | draft | paused
CRON_SECRET=generate-32-hex   # Vercel cron sends this as Bearer token; also the admin token

# Notifications (Resend — sending key)
RESEND_API_KEY=re_...
DISPATCH_NOTIFY_EMAIL=you@example.com

# Intake (optional — falls back to bundled sample ICS)
# GCAL_ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics

# Budget
LLM_DAILY_BUDGET_USD=0.50

# Optional live X posting (O2 — absent = draft-mode publish log only)
# X_API_KEY=...
# X_API_SECRET=...
# X_ACCESS_TOKEN=...
# X_ACCESS_SECRET=...
